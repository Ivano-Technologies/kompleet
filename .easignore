# Root-level .easignore — EAS archives from git root, exclusions must live here.
# Keeps only apps/mobile/ content relevant for the Android build.

# Next.js web platform files (not needed for mobile build)
.next/
src/
public/
prisma/
drizzle/
scripts/

# Root node_modules (mobile installs its own in apps/mobile/node_modules)
node_modules/

# Build artifacts & caches
.cache/
dist/
build/
out/
.vercel/
.local/

# Dev tooling
.git/
.husky/
.playwright-mcp/

# Large/unnecessary files
*.log
*.joblib
*.pkl
tsconfig.tsbuildinfo

# Env files (use EAS Secrets instead)
.env
.env.*

# Test & misc
tests/
docs/
marketing/
ml-training/
.ml-models-cache/
.backup_migrations/
generated/
.prisma/