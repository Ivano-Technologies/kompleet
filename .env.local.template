# ============================================================
# KOMPLEET PLATFORM — LOCAL ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env.local and fill in your actual values
# ❗ DO NOT COMMIT .env.local TO GIT
# ============================================================

# ------------------------------------------------------------
# Node / App
# ------------------------------------------------------------
NODE_ENV=development
APP_SECRET=your_32_character_secret_key_here_change_me

# Base URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ------------------------------------------------------------
# Supabase
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------
# AI Providers
# ------------------------------------------------------------
OPENAI_API_KEY=sk-your_openai_api_key_here
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

AI_ENABLED=true
AI_PRIMARY_PROVIDER=openai
AI_FALLBACK_ENABLED=true
AI_MAX_RETRIES=3
AI_TIMEOUT_MS=30000

# ------------------------------------------------------------
# ML Service Configuration (NEW - Feb 2026 Upgrade)
# ------------------------------------------------------------
ML_SERVICE_URL=http://localhost:5000
ML_AUTO_ACCEPT_THRESHOLD=0.80
ML_SUGGEST_THRESHOLD=0.50

# ------------------------------------------------------------
# LLM Categorization Configuration (NEW - Feb 2026 Upgrade)
# ------------------------------------------------------------
LLM_AUTO_ACCEPT_THRESHOLD=80
LLM_SUGGEST_THRESHOLD=50

# ------------------------------------------------------------
# Duplicate Detection Configuration (NEW - Feb 2026 Upgrade)
# ------------------------------------------------------------
DUPLICATE_SIMILARITY_THRESHOLD=0.85

# ------------------------------------------------------------
# Feature Flags
# ------------------------------------------------------------
NEXT_PUBLIC_ENABLE_AI_CATEGORIZATION=true
NEXT_PUBLIC_ENABLE_PDF_PARSING=true
NEXT_PUBLIC_ENABLE_MULTI_USER=false

# NEW Feature Flags (Feb 2026 Upgrade)
ENABLE_PDF_OCR=true
ENABLE_LSH_OPTIMIZATION=true
ENABLE_ENSEMBLE_CATEGORIZATION=true
ENABLE_QUALITY_MONITORING=true

# ------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_AI_TOKENS_PER_REQUEST=4000

# ------------------------------------------------------------
# Banking — Mono Connect
# ------------------------------------------------------------
MONO_SECRET_KEY=your_mono_secret_key_here
NEXT_PUBLIC_MONO_PUBLIC_KEY=your_mono_public_key_here

# ------------------------------------------------------------
# Payments (Paystack)
# ------------------------------------------------------------
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret_here
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here

# ------------------------------------------------------------
# Analytics & Monitoring
# ------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.us.sentry.io/xxx
SENTRY_AUTH_TOKEN=sntrys_xxx

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
LOG_LEVEL=info
