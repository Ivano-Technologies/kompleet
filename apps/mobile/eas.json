{
  "cli": {
    "version": ">= 3.17.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "development"
      },
      "node": "22.0.0",
      "installCommand": "pnpm install --filter ./apps/mobile..."
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "APP_ENV": "preview"
      },
      "node": "22.0.0",
      "installCommand": "pnpm install --filter ./apps/mobile..."
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "APP_ENV": "production"
      },
      "node": "22.0.0",
      "installCommand": "pnpm install --filter ./apps/mobile..."
    }
  },
  "submit": {
    "production": {}
  }
}