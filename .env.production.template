# ============================================================
# KOMPLEET PLATFORM — PRODUCTION ENVIRONMENT VARIABLES
# ============================================================
# Use these settings for production deployment (Vercel, etc.)
# Configure in your hosting platform's environment variables section
# ============================================================

# ------------------------------------------------------------
# Node / App
# ------------------------------------------------------------
NODE_ENV=production
APP_SECRET=your_production_32_character_secret_key_here

# Base URLs (update with your production domain)
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_API_URL=https://your-domain.com/api

# ------------------------------------------------------------
# Supabase
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_production_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_production_supabase_service_role_key

# ------------------------------------------------------------
# AI Providers
# ------------------------------------------------------------
OPENAI_API_KEY=sk-your_production_openai_api_key
ANTHROPIC_API_KEY=sk-ant-your_production_anthropic_key

AI_ENABLED=true
AI_PRIMARY_PROVIDER=openai
AI_FALLBACK_ENABLED=true
AI_MAX_RETRIES=3
AI_TIMEOUT_MS=30000

# ------------------------------------------------------------
# ML Service Configuration (NEW - Feb 2026 Upgrade)
# ------------------------------------------------------------
# Point to your production ML service URL
ML_SERVICE_URL=https://ml-service.your-domain.com

# Production thresholds (more conservative)
ML_AUTO_ACCEPT_THRESHOLD=0.80
ML_SUGGEST_THRESHOLD=0.50

# ------------------------------------------------------------
# LLM Categorization Configuration (NEW - Feb 2026 Upgrade)
# ------------------------------------------------------------
# Production thresholds (more conservative)
LLM_AUTO_ACCEPT_THRESHOLD=80
LLM_SUGGEST_THRESHOLD=50

# ------------------------------------------------------------
# Duplicate Detection Configuration (NEW - Feb 2026 Upgrade)
# ------------------------------------------------------------
# Production threshold (balanced)
DUPLICATE_SIMILARITY_THRESHOLD=0.85

# ------------------------------------------------------------
# Feature Flags
# ------------------------------------------------------------
NEXT_PUBLIC_ENABLE_AI_CATEGORIZATION=true
NEXT_PUBLIC_ENABLE_PDF_PARSING=true
NEXT_PUBLIC_ENABLE_MULTI_USER=true

# NEW Feature Flags (Feb 2026 Upgrade) - All enabled for production
ENABLE_PDF_OCR=true
ENABLE_LSH_OPTIMIZATION=true
ENABLE_ENSEMBLE_CATEGORIZATION=true
ENABLE_QUALITY_MONITORING=true

# ------------------------------------------------------------
# Rate Limiting (Production - stricter limits)
# ------------------------------------------------------------
RATE_LIMIT_REQUESTS_PER_MINUTE=30
RATE_LIMIT_AI_TOKENS_PER_REQUEST=4000

# ------------------------------------------------------------
# Banking — Mono Connect
# ------------------------------------------------------------
MONO_SECRET_KEY=live_sk_your_production_mono_secret
NEXT_PUBLIC_MONO_PUBLIC_KEY=live_pk_your_production_mono_public

# ------------------------------------------------------------
# Payments (Paystack)
# ------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_live_your_production_paystack_secret
PAYSTACK_WEBHOOK_SECRET=your_production_paystack_webhook_secret
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_your_production_paystack_public

# ------------------------------------------------------------
# Analytics & Monitoring
# ------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-YOUR_PRODUCTION_GA_ID
NEXT_PUBLIC_SENTRY_DSN=https://your_production_sentry_dsn
SENTRY_AUTH_TOKEN=your_production_sentry_auth_token

# ------------------------------------------------------------
# Logging (Production - less verbose)
# ------------------------------------------------------------
LOG_LEVEL=warn

# ============================================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ============================================================
# 
# Before deploying to production:
# 
# ✅ 1. Update all placeholder values with real credentials
# ✅ 2. Set ML_SERVICE_URL to your production ML service
# ✅ 3. Configure Supabase production database
# ✅ 4. Set up production OpenAI API key with billing
# ✅ 5. Configure Mono Connect with live credentials
# ✅ 6. Set up Paystack with live keys
# ✅ 7. Configure Sentry for error tracking
# ✅ 8. Test all features in staging first
# ✅ 9. Monitor quality metrics after deployment
# ✅ 10. Set up alerts for quality threshold violations
# 
# ============================================================
