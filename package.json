{
  "name": "kompleet-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "description": "Professional platform migration with quality gates",
  "author": "Kezie Okpala",
  "license": "ISC",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:types": "./scripts/check-type-drift.sh",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "format": "prettier --write .",
    "prepare": "node -e \"if(process.env.EAS_BUILD)process.exit(0);require('child_process').execSync('pnpm exec husky install',{stdio:'inherit'})\" || true",
    "postinstall": "node -e \"if(process.env.EAS_BUILD)process.exit(0);require('child_process').execSync('pnpm exec prisma generate',{stdio:'inherit'})\"",
    "precommit": "pnpm lint && pnpm typecheck && pnpm test",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "audit:ci": "node scripts/audit-ci.mjs",
    "prisma:pull": "prisma db pull",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "security:scan-ocr-logs": "node scripts/scan-ocr-log-safety.js",
    "supabase": "pnpm dlx supabase@2",
    "mobile:install": "node scripts/mobile-install.js",
    "mobile:doctor": "node scripts/mobile-doctor.js",
    "mobile:prebuild": "cd apps/mobile && pnpm exec expo prebuild",
    "verify:workspace": "pnpm list react",
    "verify:deps": "pnpm install --frozen-lockfile && pnpm build",
    "commitlint": "commitlint --edit"
  },
