{
  "buildCommand": "pnpm build",
  "devCommand": "pnpm dev",
  "installCommand": "pnpm install",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "regions": ["iad1"],
  "build": {
    "env": {
      "NEXT_PUBLIC_SUPABASE_URL": "",
      "NEXT_PUBLIC_SUPABASE_ANON_KEY": "",
      "NEXT_PUBLIC_SITE_URL": "https://kompleet.ng"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/tax-calculators/:path*",
      "destination": "/calculators/:path*",
      "permanent": true
    }
  ]
}
