{
  "extends": ["next"],
  "ignorePatterns": [".next/", "node_modules/", "out/", "build/", "dist/", "apps/", "scripts/", "*.config.js", "*.config.cjs", "*.config.mjs", "*.config.ts"],
  "rules": {
    "linebreak-style": "off",
    "quotes": "off",
    "comma-dangle": "off",
    "indent": "off",
    "camelcase": "off",
    "brace-style": "off",
    "key-spacing": "off",
    "no-unused-vars": "warn",
    "eqeqeq": "off",
    "func-style": "off",
    "jsx-quotes": "off",
    "new-parens": "off",
    "no-cond-assign": "off",
    "no-const-assign": "off",
    "no-dupe-args": "off",
    "no-dupe-keys": "off",
    "no-duplicate-case": "off",
    "no-eval": "off",
    "no-extra-bind": "off",
    "no-extra-boolean-cast": "off",
    "no-extra-semi": "off",
    "no-fallthrough": "off",
    "no-func-assign": "off",
    "no-irregular-whitespace": "off",
    "no-lone-blocks": "off",
    "no-lonely-if": "off",
    "no-mixed-spaces-and-tabs": "off",
    "no-redeclare": "off",
    "no-self-assign": "off",
    "no-unreachable": "off",
    "valid-typeof": "off"
  }
}
