# ============================================================
# KOMPLEET PLATFORM — ENVIRONMENT VARIABLES
# ============================================================
# This file documents ALL required environment variables.
# Copy to .env.local for development.
#
# ❗ DO NOT COMMIT REAL SECRETS
# ============================================================

# ------------------------------------------------------------
# Node / App
# ------------------------------------------------------------
NODE_ENV=development

# Used for signing sessions, webhooks, etc (min 32 chars)
APP_SECRET=dev_app_secret_please_change_me_32_chars_min

# Base URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ------------------------------------------------------------
# Supabase
# ------------------------------------------------------------

# Public (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ_dev_public_anon_placeholder

# Server-side ONLY
SUPABASE_SERVICE_ROLE_KEY=eyJ_dev_service_role_placeholder

# ------------------------------------------------------------
# AI Providers (SERVER ONLY)
# ------------------------------------------------------------

# OpenAI (required if AI_ENABLED=true)
OPENAI_API_KEY=sk-dev_openai_placeholder

# Anthropic (optional fallback)
ANTHROPIC_API_KEY=sk-ant-dev_placeholder

# AI configuration
AI_ENABLED=true
AI_PRIMARY_PROVIDER=openai
AI_FALLBACK_ENABLED=true
AI_MAX_RETRIES=3
AI_TIMEOUT_MS=30000

# ------------------------------------------------------------
# Feature Flags (Client-safe)
# ------------------------------------------------------------

NEXT_PUBLIC_ENABLE_AI_CATEGORIZATION=true
NEXT_PUBLIC_ENABLE_PDF_PARSING=true
NEXT_PUBLIC_ENABLE_MULTI_USER=false

# ------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------

RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_AI_TOKENS_PER_REQUEST=4000

# ------------------------------------------------------------
# Payments (Paystack)
# ------------------------------------------------------------

# Server-only
PAYSTACK_SECRET_KEY=sk_dev_paystack_placeholder
PAYSTACK_WEBHOOK_SECRET=dev_webhook_secret_placeholder

# Client-safe
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_dev_paystack_public_placeholder

# ------------------------------------------------------------
# Analytics & Monitoring
# ------------------------------------------------------------

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------

LOG_LEVEL=info
