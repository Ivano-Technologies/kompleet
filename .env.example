# ============================================================
# KOMPLEET PLATFORM — ENVIRONMENT VARIABLES
# ============================================================
# This file documents ALL required environment variables.
# Copy to .env.local for development.
#
# ❗ DO NOT COMMIT REAL SECRETS
# ============================================================

# ------------------------------------------------------------
# Node / App
# ------------------------------------------------------------
NODE_ENV=development

# Used for signing sessions, webhooks, etc (min 32 chars)
APP_SECRET=dev_app_secret_please_change_me_32_chars_min

# Base URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
# Canonical site URL for OG tags and absolute links in outbound email.
# Production: https://kompleet.techivano.com  (see docs/DOMAIN_MIGRATION.md)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------
# Authentication — Supabase Auth (Current)
# ------------------------------------------------------------
# ℹ️  Current: Supabase Auth (working, stable)
# 📋 Future: Clerk migration planned (post-MVP)
# 📄 See: docs/AUTH_MIGRATION_PLAN.md

# ------------------------------------------------------------
# Supabase
# ------------------------------------------------------------

# Public (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
# Prefer sb_publishable_... (new API keys). Legacy JWT anon keys (eyJ...) are
# deprecated end of 2026 — see docs/KEY_MIGRATION_CHECKLIST.md.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_dev_placeholder

# Server-side ONLY — prefer sb_secret_... (never expose to the browser).
# Legacy JWT service_role keys (eyJ...) are deprecated end of 2026.
# Variable name is SUPABASE_SERVICE_ROLE_KEY only — no SUPABASE_SERVICE_KEY alias.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_dev_placeholder

# ------------------------------------------------------------
# AI Providers (SERVER ONLY)
# ------------------------------------------------------------

# Anthropic Claude (primary categorization provider — see docs/AI_SIMPLIFICATION_PLAN.md)
ANTHROPIC_API_KEY=sk-ant-dev_placeholder
ANTHROPIC_CATEGORIZE_MODEL=claude-3-5-haiku-20241022

# OpenAI (fallback provider)
OPENAI_API_KEY=sk-dev_openai_placeholder

# AI configuration
AI_ENABLED=true
AI_PROVIDER=claude
AI_PRIMARY_PROVIDER=claude
AI_FALLBACK_ENABLED=true
AI_MAX_RETRIES=3
AI_TIMEOUT_MS=30000

# ------------------------------------------------------------
# Categorization confidence thresholds
# ------------------------------------------------------------

# Legacy ML_* names still read by ensemble as fallbacks; prefer LLM_* below
ML_AUTO_ACCEPT_THRESHOLD=0.80
ML_SUGGEST_THRESHOLD=0.50

# Confidence threshold for auto-accepting LLM categorizations (0-100)
LLM_AUTO_ACCEPT_THRESHOLD=80

# LLM categorization suggestion threshold (0-100)
LLM_SUGGEST_THRESHOLD=50

# ------------------------------------------------------------
# Duplicate Detection Configuration (NEW - Feb 2026 Upgrade)
# ------------------------------------------------------------

# Similarity threshold for duplicate detection (0.0 to 1.0)
# Transactions with similarity >= this threshold are considered duplicates
DUPLICATE_SIMILARITY_THRESHOLD=0.85

# ------------------------------------------------------------
# Feature Flags (Client-safe)
# ------------------------------------------------------------

NEXT_PUBLIC_ENABLE_AI_CATEGORIZATION=true
NEXT_PUBLIC_ENABLE_PDF_PARSING=true
NEXT_PUBLIC_ENABLE_MULTI_USER=false

# NEW Feature Flags (Feb 2026 Upgrade)
ENABLE_PDF_OCR=true
ENABLE_LSH_OPTIMIZATION=true
ENABLE_ENSEMBLE_CATEGORIZATION=true
ENABLE_QUALITY_MONITORING=true

# ------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------

RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_AI_TOKENS_PER_REQUEST=4000

# ------------------------------------------------------------
# Banking — Mono Connect (Financial Data)
# ------------------------------------------------------------

# Server-only

# Client-safe (used in Mono Connect widget)

# ------------------------------------------------------------
# Payments (Paystack)
# ------------------------------------------------------------

# Server-only
PAYSTACK_SECRET_KEY=sk_dev_paystack_placeholder
PAYSTACK_WEBHOOK_SECRET=dev_webhook_secret_placeholder

# Client-safe
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_dev_paystack_public_placeholder

# ------------------------------------------------------------
# Email (Resend)
# ------------------------------------------------------------
# Required for: contact form, deadline reminders, transactional emails
# Get from: resend.com → API Keys | Verify domain ivanotechnologies.com
# See: docs/RESEND_SETUP.md
RESEND_API_KEY=re_placeholder

# ------------------------------------------------------------
# Analytics & Monitoring
# ------------------------------------------------------------

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------

LOG_LEVEL=info

# Sentry — Error Tracking & Performance Monitoring
# Get DSN from: sentry.io → Project Settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.us.sentry.io/xxx
# Get auth token from: sentry.io → Settings → Auth Tokens
# Only needed in CI/Vercel for source map uploads
SENTRY_AUTH_TOKEN=sntrys_xxx

# ============================================================
# NOTES FOR NEW ENVIRONMENT VARIABLES (Feb 2026 Upgrade)
# ============================================================
#
# ML_AUTO_ACCEPT_THRESHOLD & ML_SUGGEST_THRESHOLD:
#   - Range: 0.0 to 1.0 (e.g., 0.80 = 80% confidence)
#   - Higher = more conservative (fewer auto-categorizations)
#   - Lower = more aggressive (more auto-categorizations)
#   - Recommended: 0.80 for production, 0.90 for testing
#
# LLM_AUTO_ACCEPT_THRESHOLD:
#   - Range: 0 to 100 (for backward compatibility)
#   - Same logic as ML thresholds
#   - Recommended: 80 for production, 90 for testing
#
# DUPLICATE_SIMILARITY_THRESHOLD:
#   - Range: 0.0 to 1.0 (e.g., 0.85 = 85% similarity required)
#   - Higher = stricter duplicate detection (fewer false positives)
#   - Lower = looser duplicate detection (catches more duplicates)
#   - Recommended: 0.85 for production, 0.90 for testing
#
# ENABLE_PDF_OCR:
#   - true: Enable OCR fallback for scanned PDFs (requires tesseract.js)
#   - false: Only extract text from text-based PDFs
#
# ENABLE_LSH_OPTIMIZATION:
#   - true: Use LSH algorithm for duplicate detection (faster for large datasets)
#   - false: Use traditional O(n²) algorithm (simpler, works for all sizes)
#
# ENABLE_ENSEMBLE_CATEGORIZATION:
#   - true: Use LLM → Rule → ML fallback chain (higher accuracy)
#   - false: Use single categorization method
#
# ENABLE_QUALITY_MONITORING:
#   - true: Track and report data quality metrics
#   - false: Disable quality monitoring
#
# ============================================================
